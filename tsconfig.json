{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2018",
    "allowJs": true,
    "moduleResolution": "node",
    "isolatedModules": true,
    "strict": true,
    "lib": ["DOM", "ES5", "ES6", "ES7", "ES2018", "ES2020", "ES2021"],
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
